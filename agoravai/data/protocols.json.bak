        {
          "id": "diag-mom1mhto-tpv88t",
          "type": "resource",
          "resource": {
            "schemaVersion": "1",
            "type": "clinical_resource",
            "id": "escala_mmrc_dispneia",
            "title": "Escala mMRC de dispneia",
            "mode": "classification_scale",
            "subtitle": "Classificação da dispneia",
            "source": "checar",
            "categories": [
              {
                "label": "Classificação 0",
                "value": "0",
                "description": "Dispneia só aos grandes esforços/exercício intenso"
              },
              {
                "label": "Classificação 1",
                "value": "1",
                "description": "Dispneia se andar rápido ou subir ladeira"
              },
              {
                "label": "Classificação 2",
                "value": "2",
                "description": "Anda mais devagar do que pessoas da mesma idade devido falta de ar, ou há necessidade de parar para respirar ao caminhar em seu próprio ritmo, no plano"
              },
              {
                "label": "Classificação 3",
                "value": "3",
                "description": "Dispneia após andar menos de 100 metros ou após andar poucos minutos no plano"
              },
              {
                "label": "Classificação 4",
                "value": "4",
                "description": "Muita falta de ar para sair de casa, ou falta de ar quando tira ou veste uma roupa"
              }
            ]
          }
        }
      ]
    },
    "exames": {
      "blocks": [
        {
          "title": "Diagnóstico",
          "sequences": [
            {
              "name": "Espirometria",
              "exams": [
                "Espirometria com prova de broncodilatação"
              ],
              "examNotes": {
                "Espirometria com prova de broncodilatação": "VEF1 < 70"
              }
            }
          ],
          "subtitle": "Exame diagnóstico"
