[
  {
    "id": "has",
    "name": "Hipertensão Arterial Sistêmica",
    "category": "Cardiologia",
    "diagnostico": {
      "criteria": "O diagnóstico de HAS deve ser baseado em pelo menos duas aferições de pressão arterial realizadas em consultas médicas diferentes, ou através da Monitorização Ambulatorial da Pressão Arterial (MAPA) / Medida Residencial da Pressão Arterial (MRPA).",
      "highlight": {
        "title": "MAPA de 24 horas",
        "content": "Indicado em caso de suspeita de HA do avental branco, HA mascarada ou variabilidade excessiva da PA."
      },
      "classification": {
        "title": "Classificação no Consultório",
        "headers": [
          "Categoria",
          "Sistólica (mmHg)",
          "Diastólica (mmHg)"
        ],
        "rows": [
          {
            "cells": [
              "Ótima",
              "< 120",
              "< 80"
            ]
          },
          {
            "cells": [
              "Normal",
              "120 - 129",
              "80 - 84"
            ]
          },
          {
            "cells": [
              "Pré-hipertensão",
              "130 - 139",
              "85 - 89"
            ]
          },
          {
            "cells": [
              "HAS Estágio 1",
              "140 - 159",
              "90 - 99"
            ]
          },
          {
            "cells": [
              "HAS Estágio 2",
              "160 - 179",
              "100 - 109"
            ],
            "isHighlight": true
          },
          {
            "cells": [
              "HAS Estágio 3",
              "≥ 180",
              "≥ 110"
            ],
            "isHighlight": true
          }
        ]
      }
    },
    "exames": {
      "blocks": [
        {
          "title": "Primeiros exames",
          "sequences": [
            {
              "name": "Perfil Metabólico",
              "exams": [
                "Creatinina plasmática",
                "Potássio plasmático",
                "Glicemia de jejum",
                "Perfil lipídico completo"
              ]
            },
            {
              "name": "Urinálise",
              "exams": [
                "Sumário de urina (EAS)",
                "Proteinúria de 24 horas (se necessário)"
              ]
            }
          ],
          "subtitle": "Solicitados para todo paciente com diagnóstico recente de hipertensão."
        },
        {
          "title": "Avaliação de LOA",
          "sequences": [
            {
              "name": "Cardíaco",
              "exams": [
                "Eletrocardiograma de repouso (ECG)",
                "Ecocardiograma transtorácico"
              ]
            }
          ],
          "subtitle": "Investigação de Lesões de Órgãos-Alvo."
        }
      ],
      "observations": "Sempre avaliar função renal antes de iniciar iECA ou BRA."
    },
    "orientacoes": {
      "blocks": [
        {
          "title": "Dieta e Estilo de Vida",
          "items": [
            "Reduzir consumo de sódio para < 2g/dia (5g de sal).",
            "Adotar padrão alimentar DASH (rico em frutas e vegetais).",
            "Cessação do tabagismo e moderação no álcool."
          ]
        },
        {
          "title": "Atividade Física",
          "items": [
            "Aeróbico: 150 min/semana de intensidade moderada.",
            "Exercícios de resistência: 2-3 vezes por semana."
          ]
        }
      ]
    },
    "prescricao": {
      "items": [
        {
          "drug": "Losartana Potássica",
          "dose": "50mg",
          "presentation": "1 caixa",
          "posology": "Tomar 1 comprimido por via oral uma vez ao dia.",
          "orientations": {
            "cuidados": "Monitorar pressão arterial regularmente e função renal.",
            "contraindicacoes": "Gravidez, amamentação, hiperpotassemia grave.",
            "sus": "Disponível na Farmácia Popular / Unidades Básicas de Saúde.",
            "gerais": ""
          }
        },
        {
          "drug": "Anlodipino",
          "dose": "5mg",
          "presentation": "30 comprimidos",
          "posology": "Tomar 1 comprimido por via oral uma vez ao dia.",
          "orientations": {
            "cuidados": "Pode causar edema maleolar (inchaço nos tornozelos).",
            "contraindicacoes": "",
            "sus": "Disponível na rede pública de saúde.",
            "gerais": ""
          }
        }
      ],
      "sections": []
    },
    "metas": {
      "blocks": [
        {
          "title": "Metas Gerais",
          "content": "Para a maioria dos pacientes hipertensos, a meta é manter a PA < 140/90 mmHg."
        },
        {
          "title": "Grupos Específicos",
          "content": "Pacientes com alto risco cardiovascular ou DM.",
          "table": {
            "headers": [
              "Grupo",
              "Meta (mmHg)"
            ],
            "rows": [
              [
                "Alto Risco CV",
                "< 130/80"
              ],
              [
                "Idosos Hígidos",
                "130 - 139 / 70 - 79"
              ],
              [
                "Doença Renal Crônica",
                "< 130/80"
              ]
            ]
          }
        }
      ]
    }
  },
  {
    "id": "dm2",
    "name": "Diabetes Mellitus Tipo 2",
    "category": "Endocrinologia",
    "diagnostico": {
      "criteria": "O diagnóstico é confirmado por Glicemia de Jejum ≥ 126 mg/dL, HbA1c ≥ 6,5% ou TOTG de 2h ≥ 200 mg/dL.",
      "classification": {
        "title": "Status Glicêmico",
        "headers": [
          "Condição",
          "Glicemia Jejum (mg/dL)",
          "HbA1c (%)"
        ],
        "rows": [
          {
            "cells": [
              "Normal",
              "70 - 99",
              "< 5.7"
            ]
          },
          {
            "cells": [
              "Pré-Diabetes",
              "100 - 125",
              "5.7 - 6.4"
            ]
          },
          {
            "cells": [
              "Diabetes",
              "≥ 126",
              "≥ 6.5"
            ],
            "isHighlight": true
          }
        ]
      }
    },
    "exames": {
      "blocks": [
        {
          "title": "Avaliação Inicial",
          "sequences": [
            {
              "name": "Controle Glicêmico",
              "exams": [
                "Glicemia de jejum",
                "Hemoglobina Glicada (HbA1c)"
              ]
            },
            {
              "name": "Microvascular",
              "exams": [
                "Microalbuminúria em amostra isolada",
                "Fundo de olho"
              ]
            }
          ],
          "subtitle": "Exames para estratificação de risco e triagem de complicações."
        }
      ]
    },
    "orientacoes": {
      "blocks": [
        {
          "title": "Educação em Diabetes",
          "items": [
            "Auto-monitorização da glicemia capilar conforme orientação.",
            "Cuidado diário com os pés (inspeção e calçados adequados).",
            "Portar identificação de diabético em viagens."
          ]
        }
      ]
    },
    "prescricao": {
      "items": [
        {
          "drug": "Metformina XR",
          "dose": "500mg",
          "presentation": "60 comprimidos",
          "posology": "Tomar 1 comprimido por via oral após o jantar.",
          "orientations": {
            "cuidados": "Iniciar com dose baixa para minimizar efeitos TGI.",
            "contraindicacoes": "",
            "sus": "",
            "gerais": ""
          }
        }
      ],
      "sections": []
    },
    "metas": {
      "blocks": [
        {
          "title": "Metas de Controle",
          "content": "As metas devem ser individualizadas considerando idade e comorbidades.",
          "table": {
            "headers": [
              "Parâmetro",
              "Meta Alvo"
            ],
            "rows": [
              [
                "Hemoglobina Glicada",
                "< 7.0%"
              ],
              [
                "Glicemia Pré-prandial",
                "80 - 130 mg/dL"
              ],
              [
                "Glicemia Pós-prandial",
                "< 180 mg/dL"
              ]
            ]
          }
        }
      ]
    }
  },
  {
    "id": "qyjwqly4y",
    "name": "DPOC",
    "category": "Pneumologia",
    "diagnostico": {
      "criteria": "Considerar o diagnóstico de DPOC e realizar espirometria, se houver algum desses indicadores :\n- Dispneia progressiva ao longo do tempo\n- Chiado recorrente\n- Tosse crônica\n- ITR recorrente\n- História de fatores de risco",
      "highlight": {
        "title": "DIAGNÓSTICO",
        "content": "O diagnóstico é realizado através da clínica sugestiva + espirometria!"
      },
      "classification": {
        "title": "Pontuação GOLD",
        "headers": [
          "Categoria",
          "Classificação"
        ],
        "rows": []
      },
      "blocks": [
        {
