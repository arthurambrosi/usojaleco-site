      "tabs": [
        {
          "titulo": "TTO não farmacológico",
          "slug": "tto-nao-farmacologico",
          "mode": "free",
          "meta": {
            "orientacoes": "",
            "alertas": "",
            "notas": "",
            "revisadoEspecialista": false
          },
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Orientações ao paciente",
                  "marks": [
                    "bold"
                  ]
                }
              ]
            },
            {
              "type": "divider"
            },
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "text": "Evitar exposição a alérgenos e manter higiene ambiental: "
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "text": "Controle de ácaros: uso de capas impermeáveis para colchões e travesseiros, lavagem de roupas com água quente e secagem em secadora; aspiração semanal de tapetes e estofados; "
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "text": "Em caso de alergia a animais de estimação, mantê-los fora do quarto do paciente e usar purificadores de ar de alta potência e com filtros HEPA "
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "text": "Controle de fungos: ambientes com boa ventilação e ensolarados, e com controle da umidade intradomiciliar."
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Orientar lavagem nasal com solução salina isotônica",
                  "marks": [
                    "bold"
                  ]
                }
              ]
            },
            {
              "type": "divider"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Soro fisiológico 0,9%"
                }
              ]
            },
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "text": "Uso : 1-2 vezes por dia"
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "text": "Utilizar seringas de 10 a 20ml; spray nasal ou dispostivos em jato"
                    }
                  ]
                }
              ]
            }
          ],
